# Скопируйте этот файл в .env и заполните своими значениями.

# Authorization key из личного кабинета GigaChat (base64(client_id:client_secret))
GIGACHAT_AUTH_KEY=

# Scope ключа: GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модели
GIGACHAT_EMBED_MODEL=EmbeddingsGigaR
GIGACHAT_CHAT_MODEL=GigaChat-2-Max

# Если корневой сертификат МинЦифры не установлен — оставьте false
GIGACHAT_VERIFY_SSL=false
